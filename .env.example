# VisionBridge Environment Variables Template
# Copy this file to .env and fill in your own keys.
# Run with: flutter run --dart-define-from-file=.env

# Groq API Keys (Multi-Account Failover Pool)
GROQ_KEY_1=your_groq_api_key_account_1
GROQ_KEY_2=your_groq_api_key_account_2
GROQ_KEY_3=your_groq_api_key_account_3

# Gemini API Key
GEMINI_KEY=your_gemini_api_key
